# Raw and processed datasets
data/raw/*.xlsx
data/raw/*.xls
data/raw/demo/
data/processed/*.csv
data/processed/*.parquet

# Power BI model exports. The public deployment snapshot lives in the tracked
# data/public_dashboard/ directory; these local pipeline outputs stay ignored.
data/powerbi/*.parquet

# Authored Power BI report. Binary, produced by Power BI Desktop rather than by
# this repository, and rebuilt by hand from powerbi/BUILD_GUIDE.md.
*.pbix

# Rebuilt local analytical database
database/*.duckdb
database/*.wal

# Demo-only report outputs. The root reports/ files are the tracked benchmark.
reports/demo/

# Credentials and local configuration
.env
*.log

# Python
__pycache__/
*.pyc
.venv/
.ruff_cache/

# Power BI temporary files
*.pbit.tmp
*.pbix.tmp

# Local handoff notes
HANDOFF.md
